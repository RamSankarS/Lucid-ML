# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ==========================================
# Backend (Python / FastAPI / ML)
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.hypothesis/

# Machine Learning Large Artifacts & Raw Datasets
# (Track baseline scripts/schemas, but ignore heavy generated weights and datasets)
*.pkl
*.h5
*.onnx
*.pt
*.pth
*.bin
*.safetensors
data/raw/*
!data/raw/.gitkeep

# ==========================================
# Frontend (Node / React / Vite)
# ==========================================

# Dependencies
node_modules/
.pnpm-store/

# Production Build Output
frontend/dist/
frontend/build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite / React Cache
.vite/
.eslintcache
.stylelintcache
